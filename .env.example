# Masold at .env-be es toltsd ki. A .env-et a .gitignore fedi - NE commitolj kulcsot.

# --- Gemini (nem determinisztikus; a prototipus szolgaltatoja) ---
# Megvan: C:\dev\kollabor-cockpit-security\.env -> GEMINI_API_KEY
GEMINI_API_KEY=

# --- Azure AI Speech (determinisztikus, hu-HU Noemi/Tamas) ---
# A portalon FREE F0 arszintet valassz, ne S0-t: az F0 a kvota eleresekor
# HIBAT ad, nem szamlat (fail-closed). Keys and Endpoint -> KEY 1 + Region.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# --- Piper (determinisztikus, helyi, ingyenes - draft szint) ---
# Telepites: lasd bench/README-TELEPITES.md
PIPER_BIN=
PIPER_VOICE_DIR=
